# HuggingFace token — required to download Gemma 2 model weights.
# Gemma 2 is a gated model: accept the license at
# https://huggingface.co/google/gemma-2-2b before using your token.
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Neuronpedia API key — optional, but recommended to avoid rate-limiting
# when fetching feature descriptions.
# Get a free key at: https://www.neuronpedia.org/settings
NEURONPEDIA_API_KEY=your_neuronpedia_api_key_here
